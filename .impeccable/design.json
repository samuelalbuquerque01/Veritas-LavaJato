  "narrative": {
    "northStar": "The Detail Workshop",
    "overview": "Real vehicles and the physical workshop lead the experience. Near-black, graphite, silver and red express the automotive identity; condensed headings sit at a human scale beside readable supporting copy and direct contact actions.\n\nThe opening gives the photograph more space than the invitation alongside it. Practical visit information follows immediately. Silver service menus, an uneven photographic gallery, a red delivery rate sheet, an open promotion composition and staggered workshop photographs create distinct reading rhythms without decorative overlays.",
    "keyCharacteristics": [
      "Real service photography comes first.",
      "Compact condensed headings and readable supporting text.",
      "Silver information surfaces and a red commercial delivery region.",
      "Ruled menus, open compositions and restrained movement."
    ],
    "rules": [
      {
        "name": "The Accent Has a Job Rule",
        "body": "Use red for contact actions and the delivery offer within the black, graphite and silver identity.",
        "section": "colors"
      },
      {
        "name": "Catalogue price clarity",
        "body": "Keep catalogue prices separate from delivery and promotional offers. Use a flat responsive comparison table with currency in its caption and full BRL accessible cell labels, native disclosures for inclusions, and ruled additional-service lists.",
        "section": "components"
      }
    ],
    "dos": [
      "Do retain the black, graphite, silver and red automotive identity.",
      "Do put real service photography and practical contact information in the foreground.",
      "Do use condensed headings at a scale that leaves room for photographs.",
      "Do maintain visible keyboard focus and respect reduced motion.",
      "Do use varied open compositions, ruled menus and distinct color regions."
    ],
    "donts": [
      "Don't reproduce promotional posters as the web page composition.",
      "Don't replace real-work evidence with invented results or unsupported before-and-after imagery.",
      "Don't add decorative overlays that obscure the vehicles or workshop."
    ]
